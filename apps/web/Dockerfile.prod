FROM node:24-alpine AS builder

WORKDIR /app

# Accept API base URL as a build argument, defaulting to relative path /api
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY package*.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

RUN npm ci

COPY . .

# Build the workspaces (shared package, then web build)
RUN npm run build

FROM nginx:1.27-alpine AS runner

# Copy production SPA build to nginx public path
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy custom Nginx configuration for routing & proxying
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
