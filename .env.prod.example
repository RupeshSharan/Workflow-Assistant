# ==============================================================================
# AI WORKFLOW PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your VPS and configure secure, random credentials.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
POSTGRES_DB=workflow_platform
POSTGRES_USER=workflow
# CHANGE THIS: Set a strong, alphanumeric secret password for PostgreSQL
POSTGRES_PASSWORD=replace_this_with_a_secure_postgres_password

# --- REDIS CACHE SYSTEM CONFIGURATION ---
# CHANGE THIS: Set a strong secret password to prevent unauthorized database commands
REDIS_PASSWORD=replace_this_with_a_secure_redis_password

# --- TOKEN ENCRYPTION CONFIGURATION ---
# CHANGE THIS: Generate a production-grade 32+ byte string (e.g., openssl rand -base64 32)
JWT_SECRET=replace_this_with_a_long_secure_jwt_secret_key_minimum_thirty_two_chars
JWT_EXPIRES_IN=8h

# --- DOMAIN URL CONFIGURATION ---
# CHANGE THIS: The public production domain hosting your platform client
WEB_ORIGIN=http://yourdomain.com

# --- AI WORKSPACE INTERACTION MODELS ---
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- S3 COMPLIANT OBJECT STORAGE (MINIO) ---
S3_REGION=us-east-1
S3_BUCKET=workflow-documents
# CHANGE THIS: Create production-safe keys for PDF/Document upload access
S3_ACCESS_KEY=replace_with_a_secure_minio_access_key
S3_SECRET_KEY=replace_with_a_secure_minio_secret_key
